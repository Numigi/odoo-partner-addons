<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_partner_view_form_inherit_partner_artist" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_ca.res_partner_form_inherit_ca"/>
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="country_code" invisible="1" />
            </field>
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="attrs">{'invisible':[('country_code', '=', 'CA')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_ca_pst']" position="attributes">
                <attribute name="attrs">{'invisible':[('country_code', '!=', 'CA')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_ca_pst']" position="after">
                <field name="qst" placeholder="1234567890TQ1234" 
                       attrs="{'invisible':[('country_code', '!=', 'CA')]}" />
            </xpath>
        </field>
    </record>

</odoo>
