<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record model="queue.job.channel" id="channel_res_partner_duplicate_ir_cron">
            <field name="name">res_partner_duplicate.ir_cron</field>
            <field name="parent_id" ref="queue_job.channel_root" />
        </record>

        <record id="ir_cron_create_duplicates" model="ir.cron">
            <field name="name">Find Partner Duplicates</field>
            <field name="model_id" ref="partner_duplicate_mgmt.model_res_partner_duplicate"/>
            <field name="state">code</field>
            <field name="code">model.create_duplicates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="run_as_queue_job" eval="True"/>
            <field name="no_parallel_queue_job_run" eval="True"/>
            <field name="channel_id" ref="channel_res_partner_duplicate_ir_cron"/>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>

   </data>
</odoo>
